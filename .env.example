# CampusCare AI — environment configuration
#
# Copy to `.env` and adjust. `.env` is gitignored; this file is committed.
# Every variable below is optional in development: the defaults shown are what
# the API uses when the variable is unset.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# development | dev | local | test  ->  the built-in fallback JWT secret is
#                                     allowed. Anything else requires JWT_SECRET.
APP_ENV=development

# HTTP listen port for the API server.
PORT=8080

# ---------------------------------------------------------------------------
# HTTP/2 and TLS
# ---------------------------------------------------------------------------
# HTTP/2 is enabled by default. What that means depends on whether TLS is
# configured below:
#
#   * TLS configured   ->  HTTP/2 negotiated over ALPN, HTTP/1.1 fallback.
#   * no TLS           ->  h2c, the cleartext upgrade, alongside HTTP/1.1.
#
# Set to false only if a proxy in front insists on HTTP/1.1.
HTTP2_ENABLED=true

# PEM certificate and private key. Both must be set together, or startup fails.
# In production these are REQUIRED: serving this API over plain HTTP would put
# login credentials on the wire in the clear. Generate a local certificate for
# development with:
#
#   openssl req -x509 -newkey rsa:2048 -nodes -days 365 \
#     -keyout server.key -out server.crt -subj "/CN=localhost" \
#     -addext "subjectAltName=DNS:localhost,IP:127.0.0.1"
#
TLS_CERT_FILE=
TLS_KEY_FILE=

# Networks whose X-Forwarded-For may be believed, comma-separated CIDRs. Empty
# means trust nobody and use the direct peer address, which is the safe default:
# an open proxy-trust setting lets a caller mint a fresh rate-limiter bucket on
# every request and forge their address in the audit trail. Set this only to the
# load balancer's address when one is actually in front of the API.
TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# Authentication throttling
# ---------------------------------------------------------------------------
# Applied per client IP to /auth/login and /auth/refresh. /auth/register gets
# three times this budget so a shared campus NAT does not lock everyone out.
AUTH_RATE_LIMIT_PER_MINUTE=10
AUTH_RATE_LIMIT_BURST=5

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=campuscare
# Set to `require` in production.
DB_SSLMODE=disable

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# REQUIRED when APP_ENV is not a development value. Startup fails otherwise.
# Must be at least 32 characters.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# `iss` claim on issued tokens.
JWT_ISSUER=campuscare-api

# Access token lifetime (Go duration syntax).
JWT_TTL=24h

# Refresh token lifetime (30 days).
JWT_REFRESH_TTL=720h

# ---------------------------------------------------------------------------
# Google OAuth 2.0 (optional)
# ---------------------------------------------------------------------------
# The OAuth routes return 501 until all three are set. Leave blank to disable.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI configured in the Google Cloud console.
GOOGLE_REDIRECT_URL=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Explicit allow-list, comma-separated. Never use `*` in production.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Vector store (Weaviate) — semantic arm of hybrid retrieval
# ---------------------------------------------------------------------------
# Optional. When unreachable the API logs the reason at start-up and hybrid
# search continues with the BM25 lexical arm alone.

WEAVIATE_HOST=localhost:8081
WEAVIATE_SCHEME=http

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# trace | debug | info | warn | error
LOG_LEVEL=info

# json | text
LOG_FORMAT=text

# ---------------------------------------------------------------------------
# Frontend (set in frontend/.env.local, not here)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# ---------------------------------------------------------------------------
# On-device AI (WebLLM on WebGPU — the only generative runtime)
# ---------------------------------------------------------------------------
# The model loads lazily: nothing is downloaded until a request actually needs
# generation. Structured campus requests and search never load it.
# NEXT_PUBLIC_WEBLLM_MODEL=Qwen2.5-0.5B-Instruct-q4f16_1-MLC
# NEXT_PUBLIC_WEBLLM_CONTEXT_WINDOW=4096
# NEXT_PUBLIC_WEBLLM_TEMPERATURE=0.7
# NEXT_PUBLIC_WEBLLM_TOP_P=0.95
# NEXT_PUBLIC_WEBLLM_MAX_TOKENS=512
# ---------------------------------------------------------------------------
# Database Pool Tuning
# ---------------------------------------------------------------------------
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTHCHECK_PERIOD=1m
DB_CONNECT_TIMEOUT=5s

# ---------------------------------------------------------------------------
# Redis (Distributed Cache/Rate Limiting)
# ---------------------------------------------------------------------------
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=2
REDIS_DIAL_TIMEOUT=2s
REDIS_READ_TIMEOUT=500ms
REDIS_WRITE_TIMEOUT=500ms
REDIS_IDLE_TIMEOUT=5m

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_STORE=memory
RATE_LIMIT_REDIS_PREFIX=campuscare:ratelimit:

# ---------------------------------------------------------------------------
# Load Balancer/Proxy Trust
# ---------------------------------------------------------------------------
TRUSTED_PROXIES=
